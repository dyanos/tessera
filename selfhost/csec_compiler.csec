    val appendHeader42: Int = csec_string_builder_append(builder, generateLLVMStringLiteralGlobals(tokens));
    var emitted: Boolean = false;
    var hasMain: Boolean = false;
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def") and
            !(cursor > 0 and tokenIs(tokens, cursor - 1, kindKeyword(), "external"))) {
            if (strEq(topLevelDeclName(tokens, cursor), "main")) {
                hasMain = true;
                val appendMainWrapper: Int = csec_string_builder_append(builder,
                    "define i32 @main(i32 %argc, ptr %argv) {\n" +
                    "entry:\n" +
                    "  call void @csec_set_command_line_args(i32 %argc, ptr %argv)\n" +
                    "  %ret = call i32 @csec_user_main()\n" +
                    "  ret i32 %ret\n" +
                    "}\n");
            }
            val definition: String = generateLLVMFunctionDefinition(tokens, cursor);
            if (definition.length > 0) {
                val appendDefinition: Int = csec_string_builder_append(builder, definition);
                emitted = true;
            }
        }
        val next: Int = advanceTopLevelDecl(tokens, cursor);
        if (next <= cursor) {
            cursor = cursor + 1;
        }
        else {
            cursor = skipTrivia(tokens, next);
        }
    }
    if (!emitted) {
        val fallbackMain: String =
            "define i32 @main() {\n" +
            generateLLVMMainBody(tokens) +
            "}\n";
        val appendFallbackMain: Int = csec_string_builder_append(builder, fallbackMain);
    }
    return 0;
}

def selfhostScopeDeclarations(): String {
    return "declare ptr @csec_selfhost_scope_begin()\n" +
        "declare void @csec_selfhost_scope_track(ptr, ptr)\n" +
        "declare void @csec_selfhost_tensor_track(ptr, ptr)\n" +
        "declare ptr @csec_selfhost_scope_slot(ptr, i32)\n" +
        "declare void @csec_selfhost_scope_store(ptr, ptr)\n" +
        "declare void @csec_selfhost_scope_collect(ptr)\n" +
        "declare void @csec_selfhost_scope_end(ptr, ptr)\n" +
        "declare ptr @csec_llvm_selfhost_scope(ptr, i32)\n";
}

def generateLLVMModule(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    var output: String = "; ModuleID = 'csec.selfhost'\n" +
        "source_filename = \"csec.selfhost\"\n\n" +
        "declare i64 @csec_string_length(ptr)\n" +
        "declare i8 @csec_string_char_at(ptr, i32)\n\n" +
        "declare i32 @csec_lex_quoted(ptr, i32)\n" +
        "declare i32 @csec_lex_number(ptr, i32)\n" +
        "declare i32 @csec_lex_identifier(ptr, i32)\n" +
        "declare i32 @csec_lex_line_comment(ptr, i32)\n" +
        "declare i32 @csec_lex_block_comment(ptr, i32)\n" +
        "declare i32 @csec_digit_value(i8)\n" +
        "declare i32 @csec_is_keyword(ptr)\n" +
        "declare i32 @csec_to_int(ptr)\n" +
        "declare i32 @csec_line_start(ptr, i32)\n" +
        "declare i32 @csec_line_end(ptr, i32)\n" +
        "declare i32 @csec_validate_balanced(ptr)\n" +
        "declare i32 @csec_starts_top_level_declaration(ptr, i32)\n" +
        "declare i32 @csec_validate_top_level(ptr)\n" +
        "declare ptr @csec_top_level_decl_kind(ptr, i32)\n" +
        "declare ptr @csec_top_level_decl_name(ptr, i32)\n" +
        "declare i32 @csec_count_function_params(ptr, i32)\n" +
        "declare i32 @csec_token_is_top_level_operator(ptr, i32, i32)\n" +
        "declare i32 @csec_find_top_level_operator(ptr, i32, i32, i32)\n" +
        "declare i32 @csec_find_top_level_match(ptr, i32, i32)\n" +
        "declare i32 @csec_find_lambda_arrow(ptr, i32, i32)\n" +
        "declare ptr @csec_generate_symbol_table(ptr)\n" +
        "declare ptr @csec_append_expression_until(ptr, i32, i32)\n" +
        "declare ptr @csec_generate_expression_ast(ptr, i32, i32)\n" +
        "declare ptr @csec_generate_statement_ast(ptr, i32, i32)\n" +
        "declare ptr @csec_generate_body_ast(ptr, i32, i32)\n" +
        "declare i32 @csec_find_function_param_start(ptr, i32)\n" +
        "declare ptr @csec_generate_c_body(ptr, i32, i32, ptr)\n" +
        "declare ptr @csec_generate_c_expression(ptr, i32, i32)\n" +
        "declare ptr @csec_ir_operator_name(ptr)\n" +
        "declare ptr @csec_ir_type_name(ptr)\n" +
        "declare i32 @csec_expression_top_level_operator(ptr, i32, i32)\n" +
        "declare i32 @csec_find_token_text_in_range(ptr, i32, i32, ptr)\n" +
        "declare i32 @csec_find_closing_token(ptr, i32, i32, ptr, ptr)\n" +
        "declare i32 @csec_find_statement_paren_start(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_paren_end(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_block_start(ptr, i32, i32)\n" +
        "declare i32 @csec_find_statement_block_end(ptr, i32, i32)\n" +
        "declare i32 @csec_count_comma_separated(ptr, i32, i32)\n" +
        "declare i32 @csec_find_last_top_level_token(ptr, i32, i32, ptr)\n" +
        "declare ptr @csec_llvm_lexer_helper_definition(ptr)\n" +
        "declare i64 @csec_string_builder_new()\n" +
        "declare i64 @csec_string_builder_new_file(ptr)\n" +
        "declare i32 @csec_string_builder_append(i64, ptr)\n" +
        "declare ptr @csec_string_builder_finish(i64)\n" +
        "declare i32 @csec_string_builder_write_to_file(i64, ptr)\n" +
        "declare void @csec_set_command_line_args(i32, ptr)\n" +
        "declare i32 @csec_command_line_arg_count()\n" +
        "declare ptr @csec_command_line_arg(i32)\n" +
        "declare ptr @csec_file_read_all_text(ptr)\n" +
        "declare i32 @csec_file_write_all_text(ptr, ptr)\n" +
        "declare void @csec_print_string(ptr)\n" +
        "declare void @csec_print_newline()\n" +
        "declare ptr @csec_string_concat(ptr, ptr)\n" +
        "declare i32 @csec_string_equals(ptr, ptr)\n" +
        "declare i32 @csec_string_starts_with(ptr, ptr)\n" +
        "declare ptr @csec_string_substring(ptr, i32, i32)\n" +
        "declare ptr @csec_to_string_i64(i64)\n" +
        "declare ptr @csec_to_string_double(double)\n" +
        "declare double @sqrt(double)\n" +
        "declare double @cos(double)\n" +
        "declare double @sin(double)\n" +
        "declare ptr @csec_to_string_char(i8)\n" +
        "declare ptr @csec_bigint_from_i64(i64)\n" +
        "declare ptr @csec_bigint_from_decimal(ptr)\n" +
        "declare ptr @csec_bigint_add(ptr, ptr)\n" +
        "declare ptr @csec_bigint_sub(ptr, ptr)\n" +
        "declare ptr @csec_bigint_mul(ptr, ptr)\n" +
        "declare i32 @csec_bigint_cmp(ptr, ptr)\n" +
        "declare ptr @csec_bigint_to_string(ptr)\n" +
        "declare ptr @csec_tensor_new(i64, double)\n" +
        "declare double @csec_tensor_get(ptr, i64)\n" +
        "declare void @csec_tensor_set(ptr, i64, double)\n" +
        "declare ptr @csec_tensor_new2(i64, i64, double)\n" +
        "declare double @csec_tensor_get2(ptr, i64, i64)\n" +
        "declare void @csec_tensor_set2(ptr, i64, i64, double)\n" +
        "declare ptr @csec_tensor_add(ptr, ptr)\n" +
        "declare ptr @csec_tensor_sub(ptr, ptr)\n" +
        "declare ptr @csec_tensor_mul(ptr, ptr)\n" +
        "declare ptr @csec_tensor_scale(ptr, double)\n" +
        "declare ptr @csec_tensor_div_scalar(ptr, double)\n" +
        "declare double @csec_tensor_inner(ptr, ptr)\n" +
        selfhostScopeDeclarations() +
        "declare void @csec_token_buffer_release(ptr)\n" +
        "declare ptr @csec_token_append_owned(ptr, i8, ptr)\n" +
        "declare i64 @csec_token_builder_new()\n" +
        "declare i32 @csec_token_builder_append(i64, i8, ptr)\n" +
        "declare ptr @csec_token_builder_finish(i64)\n" +
        "declare ptr @csec_tokenize_source(ptr)\n" +
        "declare i8 @csec_token_kind_at(ptr, i32)\n" +
        "declare ptr @csec_token_text_at(ptr, i32)\n" +
        "declare i32 @csec_token_is(ptr, i32, i8, ptr)\n" +
        "declare i32 @csec_advance_statement(ptr, i32, i32)\n" +
        "declare i32 @csec_advance_top_level_decl(ptr, i32)\n" +
        "declare i32 @csec_find_decl_body_start(ptr, i32)\n" +
        "declare i32 @csec_find_decl_body_end(ptr, i32)\n" +
        "declare i32 @csec_function_param_end(ptr, i32)\n" +
        "declare ptr @csec_function_llvm_param_list(ptr, i32)\n" +
        "declare ptr @csec_function_llvm_param_allocas(ptr, i32)\n" +
        "declare ptr @csec_llvm_name_with_number(ptr, i32)\n" +
        "declare ptr @csec_llvm_string_literal_bytes(ptr)\n" +
        "declare i32 @csec_llvm_string_literal_byte_length(ptr)\n" +
        "declare ptr @csec_function_return_type_at(ptr, i32)\n" +
        "declare ptr @csec_collect_type_name(ptr, i32, i32)\n" +
        "declare i32 @csec_enclosing_function_decl_start(ptr, i32)\n" +
        "declare i32 @csec_enclosing_function_body_start(ptr, i32)\n" +
        "declare i32 @csec_enclosing_function_body_end(ptr, i32)\n" +
        "declare ptr @csec_lookup_function_return_type(ptr, ptr)\n" +
        "declare ptr @csec_lookup_visible_value_type(ptr, i32, ptr)\n" +
        "declare ptr @csec_lookup_visible_storage_name(ptr, i32, ptr)\n" +
        "declare ptr @csec_expand_imports(ptr)\n\n" +
        generateLLVMStringLiteralGlobals(tokens);
    var emitted: Boolean = false;
    var hasMain: Boolean = false;
    var cursor: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (tokenIs(tokens, cursor, kindKeyword(), "def")) {
            if (strEq(topLevelDeclName(tokens, cursor), "main")) {
                hasMain = true;
            }
            val definition: String = generateLLVMFunctionDefinition(tokens, cursor);
            if (definition.length > 0) {
                output = output + definition;
                emitted = true;
            }
        }
        val next: Int = advanceTopLevelDecl(tokens, cursor);
        if (next <= cursor) {
            cursor = cursor + 1;
        }
        else {
            cursor = skipTrivia(tokens, next);
        }
    }
    if (emitted) {
        if (hasMain) {
            return output +
                "define i32 @main(i32 %argc, ptr %argv) {\n" +
                "entry:\n" +
                "  call void @csec_set_command_line_args(i32 %argc, ptr %argv)\n" +
                "  %ret = call i32 @csec_user_main()\n" +
                "  ret i32 %ret\n" +
                "}\n";
        }
        return output;
    }
    return output +
        "define i32 @main() {\n" +
        generateLLVMMainBody(tokens) +
        "}\n";
}

def generateExecutionC(tokens: String): String {
    if (!parseProgram(tokens)) {
        return "";
    }
    return generateMainExecutionC(tokens);
}

// ---- selfhost/src/driver.csec ----
def trimAscii(text: String): String {
    var start: Int = 0;
    var end: Int = text.length;
    while (start < end and isWhitespace(text.charAt(start))) {
        start = start + 1;
    }
    while (end > start and isWhitespace(text.charAt(end - 1))) {
        end = end - 1;
    }
    return text.substring(start, end - start);
}

def stringEndsWith(text: String, suffix: String): Boolean {
    if (suffix.length > text.length) {
        return false;
    }
    val start: Int = text.length - suffix.length;
    val tail: String = text.substring(start, suffix.length);
    return tail.startsWith(suffix);
}

def parentDirectory(path: String): String {
    var cursor: Int = path.length - 1;
    while (cursor >= 0) {
        val ch: Char = path.charAt(cursor);
        if (ch == '/' or ch == '\\') {
            return path.substring(0, cursor);
        }
        cursor = cursor - 1;
    }
    return ".";
}

def replaceDotsWithSlash(text: String): String {
    var cursor: Int = 0;
    var output: String = "";
    while (cursor < text.length) {
        val ch: Char = text.charAt(cursor);
        if (ch == '.') {
            output = output + "/";
        }
        else {
            output = output + "" + ch;
        }
        cursor = cursor + 1;
    }
    return output;
}

def importTargetFromLine(line: String): String {
    val trimmed: String = trimAscii(line);
    if (trimmed.startsWith("//") or !trimmed.startsWith("import")) {
        return "";
    }
    if (trimmed.length > 6) {
        val next: Char = trimmed.charAt(6);
        if (!(next == ' ' or next == '\t' or next == '"' or next == '\'')) {
            return "";
        }
    }
    var rest: String = trimAscii(trimmed.substring(6, trimmed.length - 6));
    if (rest.length > 0 and rest.charAt(rest.length - 1) == ';') {
        rest = trimAscii(rest.substring(0, rest.length - 1));
    }
    if (rest.length >= 2 and
        ((rest.charAt(0) == '"' and rest.charAt(rest.length - 1) == '"') or
         (rest.charAt(0) == '\'' and rest.charAt(rest.length - 1) == '\''))) {
        return rest.substring(1, rest.length - 2);
    }
    return rest;
}

def importCandidate(target: String): String {
    if (stringEndsWith(target, ".csec")) {
        return target;
    }
    return build { target; ".csec"; };
}

def resolveImportPath(currentPath: String, target: String): String {
    val base: String = parentDirectory(currentPath);
    val direct: String = importCandidate(target);
    val fromBase: String = base + "/" + direct;
    if (System.IO.File.Exists(fromBase)) {
        return fromBase;
    }
    if (System.IO.File.Exists(direct)) {
        return direct;
    }
    val dotted: String = importCandidate(replaceDotsWithSlash(target));
    val dottedFromBase: String = base + "/" + dotted;
    if (System.IO.File.Exists(dottedFromBase)) {
        return dottedFromBase;
    }
    return fromBase;
}

def expandImportsFromFile(path: String, seen: String): String {
    val marker: String = "|" + path + "|";
    if (seen.contains(marker)) {
        return "";
    }
    val source: String = System.IO.File.ReadAllText(path);
    if (!source.contains("import")) {
        return source;
    }
    val nextSeen: String = seen + marker;
    var cursor: Int = 0;
    var output: String = "";
    while (cursor <= source.length) {
        var lineEnd: Int = cursor;
        while (lineEnd < source.length and source.charAt(lineEnd) != '\n') {
            lineEnd = lineEnd + 1;
        }
        val line: String = source.substring(cursor, lineEnd - cursor);
        val target: String = importTargetFromLine(line);
        if (target.length > 0) {
            val importPath: String = resolveImportPath(path, target);
            if (System.IO.File.Exists(importPath)) {
                output = output + expandImportsFromFile(importPath, nextSeen) + "\n";
            }
            else {
                output = output + line;
                if (lineEnd < source.length) {
                    output = output + "\n";
                }
            }
        }
        else {
            output = output + line;
            if (lineEnd < source.length) {
                output = output + "\n";
            }
        }
        if (lineEnd >= source.length) {
            return output;
        }
        cursor = lineEnd + 1;
    }
    return output;
}

external def csec_token_buffer_release(tokens: String): Void;

def compileTokenBuffer(tokens: String, mode: String): String {
    if (mode.startsWith("tokenlen")) {
        return "tokens=" + tokens.length + "\n";
    }
    if (mode.startsWith("ast")) {
        return generateAST(tokens);
    }
    if (mode.startsWith("symbols")) {
        return generateSymbolTable(tokens);
    }
    if (mode.startsWith("ir")) {
        return generateIR(tokens);
    }
    if (mode.startsWith("llvm")) {
        return generateLLVMModule(tokens);
    }
    return generateExecutionC(tokens);
}

def compileSource(source: String, mode: String): String {
    val tokens: String = tokenize(source);
    if (mode.startsWith("tokens")) {
        return tokens;
    }
    val output: String = compileTokenBuffer(tokens, mode);
    csec_token_buffer_release(tokens);
    return output;
}

def compileFile(inputPath: String, outputPath: String, mode: String): Int {
    val source: String = csec_expand_imports(inputPath);
    if (mode.startsWith("llvm")) {
        val builder: Long = csec_string_builder_new_file(outputPath);
        if (builder == 0) {
            System.Console.WriteLine("compile error");
            return 1;
        }
        val tokens: String = tokenize(source);
        val generated: Int = generateLLVMModuleInto(tokens, builder);
        csec_token_buffer_release(tokens);
        if (generated != 0) {
            return generated;
        }
        return csec_string_builder_write_to_file(builder, outputPath);
    }
    if (mode.startsWith("tokens")) {
        val tokens: String = tokenize(source);
        if (tokens.length == 0) {
            csec_token_buffer_release(tokens);
            System.Console.WriteLine("compile error");
            return 1;
        }
        System.IO.File.WriteAllText(outputPath, tokens);
        csec_token_buffer_release(tokens);
        return 0;
    }
    val output: String = compileSource(source, mode);
    if (output.length == 0) {
        System.Console.WriteLine("compile error");
        return 1;
    }
    System.IO.File.WriteAllText(outputPath, output);
    return 0;
}

def main(): Int {
    val argc: Int = commandLineArgCount();
    if (argc >= 4) {
        return compileFile(commandLineArg(1), commandLineArg(2), commandLineArg(3));
    }
    return compileFile("selfhost/input.csec", "selfhost/out.c", "c");
}

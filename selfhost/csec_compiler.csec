def advanceTopLevelDeclSlow(tokens: String, ordinal: Int): Int {
    var cursor: Int = ordinal;
    var paren: Int = 0;
    var brace: Int = 0;
    var bracket: Int = 0;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (cursor > ordinal and paren == 0 and brace == 0 and bracket == 0 and startsTopLevelDeclaration(tokens, cursor)) {
            return cursor;
        }
        val text: String = tokenTextAt(tokens, cursor);
        if (tokenKindAt(tokens, cursor) == kindOperator()) {
            if (strEq(text, "(")) {
                paren = paren + 1;
            }
            else if (strEq(text, ")")) {
                paren = paren - 1;
            }
            else if (strEq(text, "{")) {
                brace = brace + 1;
            }
            else if (strEq(text, "}")) {
                brace = brace - 1;
                if (brace <= 0 and paren == 0 and bracket == 0) {
                    return cursor + 1;
                }
            }
            else if (strEq(text, "[")) {
                bracket = bracket + 1;
            }
            else if (strEq(text, "]")) {
                bracket = bracket - 1;
            }
            else if (strEq(text, ";") and brace == 0 and paren == 0 and bracket == 0) {
                return cursor + 1;
            }
        }
        cursor = cursor + 1;
    }
    return cursor;
}

def findDeclBodyStart(tokens: String, ordinal: Int): Int {
    return csec_find_decl_body_start(tokens, ordinal);
}

def findDeclBodyStartSlow(tokens: String, ordinal: Int): Int {
    var cursor: Int = ordinal;
    while (tokenKindAt(tokens, cursor) != kindEof()) {
        if (cursor > ordinal and startsTopLevelDeclaration(tokens, cursor)) {
            return -1;
        }
        if (tokenIs(tokens, cursor, kindOperator(), "{")) {
            return cursor + 1;
        }
        if (tokenIs(tokens, cursor, kindOperator(), ";")) {
            return -1;
        }
        cursor = cursor + 1;
    }
    return -1;
}

def findDeclBodyEnd(tokens: String, bodyStart: Int): Int {
    return csec_find_decl_body_end(tokens, bodyStart);

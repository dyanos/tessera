// Self-host: contract clauses are accepted (and not compiled); assert checks at run time. Exit code 42.
def clamp(x: Int, lo: Int, hi: Int): Int
    requires lo <= hi
    ensures lo <= result and result <= hi
{
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

def twice(x: Int): Int requires x < 1000 ensures result == x * 2 = x * 2

def sumTo(n: Int): Int
    requires n >= 0 and n <= 1000
    ensures result == n * (n + 1) / 2
{
    var s = 0;
    var i = 0;
    while (i < n)
        invariant 0 <= i and i <= n
        invariant s == i * (i + 1) / 2
        decreases n - i
    {
        i = i + 1;
        s = s + i;
    }
    return s;
}

def main(): Int {
    assert(clamp(50, 0, 10) == 10);
    val t = twice(4);
    assert(t == 8, "twice");
    var acc = 0;
    for (k <- 1 to 3) invariant acc >= 0 {
        acc = acc + k;
    }
    return sumTo(6) + clamp(-5, 0, 10) + acc + t + 7 + 0 * twice(1);
}

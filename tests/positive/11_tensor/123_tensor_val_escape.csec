def aliasThroughVar(x: &Tensor<Double, 1, 2>, w: &Tensor<Double, 2, 2>): Tensor<Double, 1, 2> {
    val y = x @ w;
    var q = <- y;
    return q;
}

def borrowedOnly(x: &Tensor<Double, 1, 2>, w: &Tensor<Double, 2, 2>): Double {
    val y = x @ w;
    val z = y + y;
    return sum(z) + y[0, 1];
}

def main(): Int {
    val x: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(1.0);
    val w: Tensor<Double, 2, 2> = new Tensor<Double, 2, 2>(0.5);
    var acc: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(1.0);
    var i: Int = 0;
    while (i < 3) {
        val step = acc @ w;
        acc = <- step;
        i = i + 1;
    }
    if (acc[0, 0] != 1.0) { return 1; }
    var r = if (true) {
        val y = x @ w;
        y
    } else {
        clone(x)
    };
    val filler: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(9.0);
    if (r[0, 0] != 1.0) { return 2; }
    val a = aliasThroughVar(&x, &w);
    val other: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(7.0);
    if (a[0, 1] != 1.0) { return 3; }
    if (borrowedOnly(&x, &w) != 5.0) { return 4; }
    return 0;
}

// Axis reductions, extrema, argmax/argmin, *Like constructors, random fills, and integer elements.
def close(a: Double, b: Double): Boolean = abs(a - b) < 1.0e-9

def main(): Int {
    val m = new Tensor<Double, 2, 3>();
    m[0, 0] = 1.0; m[0, 1] = 5.0; m[0, 2] = 3.0;
    m[1, 0] = 4.0; m[1, 1] = 2.0; m[1, 2] = 6.0;
    val cols = sum(m, 0);                 // [5, 7, 9]
    if (!close(cols[0], 5.0) || !close(cols[2], 9.0)) { return 1; }
    val rows = mean(m, 1);                // [3, 4]
    if (!close(rows[0], 3.0) || !close(rows[1], 4.0)) { return 2; }
    val rowMax = max(m, -1);              // [5, 6]
    if (!close(rowMax[0] + rowMax[1], 11.0)) { return 3; }
    if (!close(max(m), 6.0) || !close(min(m), 1.0) || !close(prod(m), 720.0)) { return 4; }
    if (argmax(m) != 5 || argmin(m) != 0) { return 5; }
    if (!close(sum(onesLike(m)), 6.0) || !close(sum(fullLike(m, 2.5)), 15.0)) { return 6; }

    val noise = new Tensor<Double, 5000>();
    fillUniform(noise, 2.0, 4.0);
    if (min(noise) < 2.0 || max(noise) >= 4.0 || mean(noise) < 2.9 || mean(noise) > 3.1) { return 7; }

    val counts = new Tensor<Int, 3>();
    counts[0] = 7;
    counts[1] = 2.9;                      // stored, read back as the Int 2
    val total = counts[0] + counts[1];
    if (total != 9) { return 8; }
    return 0;
}

class Holder() {
    var kept: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(0.0);
    def operator +(right: Tensor<Double, 1, 2>): Int {
        kept = right;
        return 1;
    }
}

def main(): Int {
    val x: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(1.0);
    val w: Tensor<Double, 2, 2> = new Tensor<Double, 2, 2>(0.5);
    var acc: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(1.0);
    var i: Int = 0;
    while (i < 3) {
        val t: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(2.0);
        acc = t;
        i = i + 1;
    }
    val filler: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(9.0);
    if (acc[0, 0] != 2.0) { return 1; }
    val h = new Holder();
    var j: Int = 0;
    while (j < 1) {
        val y = x @ w;
        val n = h + y;
        j = j + 1;
    }
    val other: Tensor<Double, 1, 2> = new Tensor<Double, 1, 2>(7.0);
    val k = h.kept;
    if (k[0, 0] != 1.0) { return 2; }
    return 0;
}

// Locals declared inside a long loop reuse one stack slot each instead of growing the stack every
// iteration.
def tag(i: Int): String = "k" + i

def main(): Int {
    var total = 0;
    for (i <- 0 until 300000) {
        val s = tag(i % 10);
        val t = s;
        var n: Int = t.length();
        total = total + n;
    }
    if (total != 600000) { return 1; }
    return 0;
}

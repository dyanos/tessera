// A decimal literal is a Double; `f` makes a Float, and a literal in a Float position stays a Float.
def half(x: Float): Float = x * 0.5

def third(): Double = 1.0 / 3.0

def main(): Int {
    val d = 0.1;                       // Double
    val e: Double = d + 0.2;
    if (e - 0.3 > 1.0e-15 or 0.3 - e > 1.0e-15) { return 1; }   // Double precision
    val f = 0.5f;                      // Float
    val g: Float = 2.5;                // a literal narrowed to Float
    if (half(g) != 1.25f) { return 2; }
    if (f * 4.0 != 2.0f) { return 3; }
    // 1/3 differs between Float and Double precision
    val third32: Float = 1.0f / 3.0f;
    if (third() == third32) { return 4; }
    if (third() * 3.0 != 1.0) { return 5; }
    return 0;
}

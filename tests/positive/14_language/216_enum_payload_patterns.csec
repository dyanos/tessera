// Enums with data: positional fields, guards, `|` patterns, nested and literal sub-patterns.
enum Shape {
    Circle(radius: Double),
    Rect(w: Double, h: Double),
    Empty
}

enum Token { Plus, Minus, Number(value: Int), Word(text: String) }

def area(s: Shape): Double = s match {
    case Circle(r) => 3.0 * r * r;
    case Rect(w, h) if w == h => w * w;
    case Rect(w, h) => w * h;
    case Empty => 0.0;
}

def describe(t: Token): String = t match {
    case Plus | Minus => "operator";
    case Number(0) => "zero";
    case Number(n) if n < 0 => "negative";
    case Number(_) => "number";
    case Word("let") => "keyword";
    case Word(w) => "word " + w;
}

def pairScore(a: Option<Int>, b: Option<Int>): Int {
    val both: Option<Option<Int>> = Some(a);
    return both match {
        case Some(Some(x)) => x + (b match { case Some(y) => y; case None => 0; });
        case Some(None) => -1;
        case None => -2;
    };
}

def main(): Int {
    var total = 0.0;
    for (s <- [Shape.Circle(2.0), Rect(3.0, 4.0), Empty, Rect(2.0, 2.0)]) {
        total = total + area(s);
    }
    if (total != 28.0) { return 1; }
    if (describe(Plus) != "operator" || describe(Number(0)) != "zero") { return 2; }
    if (describe(Number(-5)) != "negative" || describe(Number(5)) != "number") { return 3; }
    if (describe(Word("let")) != "keyword" || describe(Word("x")) != "word x") { return 4; }
    if (pairScore(Some(2), Some(3)) != 5 || pairScore(None, Some(3)) != -1) { return 5; }
    if (Rect(2.0, 3.0).toString() != "Rect(2.000000, 3.000000)") { return 6; }
    return 0;
}

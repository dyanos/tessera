// Interfaces: implementation by classes and structs, default methods, interface-typed values with
// dynamic dispatch (variables, parameters, returns, arrays), and inherited implementations.
interface Shape {
    def area(): Double;
    def name(): String;
    def describe(): String = name() + " with area " + area()
}

class Circle(r: Double) implements Shape {
    def area(): Double = 3.0 * r * r
    def name(): String = "circle"
}

struct Square(s: Double) implements Shape {
    def area(): Double = s * s
    def name(): String = "square"
    def describe(): String = "a square"
}

class Ring(outer: Double) extends Circle { }

def total(shapes: &Array<Shape>, n: Int): Double {
    var sum = 0.0;
    for (i <- 0 until n) { sum = sum + shapes[i].area(); }
    return sum;
}

def bigger(a: Shape, b: Shape): Shape {
    if (a.area() > b.area()) { return a; }
    return b;
}

def main(): Int {
    val shapes: Array<Shape> = [new Circle(1.0), new Square(2.0), new Circle(2.0)];
    if (total(&shapes, 3) != 19.0) { return 1; }
    var sum = 0.0;
    for (s <- shapes) { sum = sum + s.area(); }
    if (sum != 19.0) { return 2; }
    if (shapes[0].describe() != "circle with area 3.000000") { return 3; }
    if (shapes[1].describe() != "a square") { return 4; }
    val s: Shape = new Square(5.0);
    if (bigger(s, new Circle(1.0)).name() != "square") { return 5; }
    val r: Shape = new Ring(1.0);
    if (r.name() != "circle") { return 6; }
    return 0;
}

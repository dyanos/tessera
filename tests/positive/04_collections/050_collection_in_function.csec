def doubleAll(): Int {
    val xs = [1, 2, 3, 4, 5];
    map (x <- xs) {
        x * 2;
    }
    return 0;
}

def sumAll(): Int {
    val xs = [1, 2, 3, 4, 5];
    reduce (x <- xs, 0) {
        x + 1;
    }
    return 0;
}

def keepPositive(): Int {
    val xs = [1, -2, 3, -4, 5];
    filter (x <- xs) {
        x > 0;
    }
    return 0;
}

def main(): Int {
    doubleAll();
    sumAll();
    keepPositive();
    return 0;
}

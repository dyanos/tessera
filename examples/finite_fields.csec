// Rings and fields from std.math.algebra: Z/nZ, GF(p), GF(p)[x], and GF(2^8).
import std.math.algebra

// The AES S-box: the inverse in GF(2^8) followed by the AES affine map.
def aesSbox(K: GaloisField, byte: Long): Long {
    var b: Long = 0;
    if (byte != 0) {
        b = K.element(byte).inverse().packed();
    }
    var out: Long = 99;                       // 0x63
    var i = 0;
    while (i < 8) {
        val bit = ((b >> i) ^ (b >> ((i + 4) % 8)) ^ (b >> ((i + 5) % 8)) ^ (b >> ((i + 6) % 8)) ^ (b >> ((i + 7) % 8))) & 1;
        out = out ^ (bit << i);
        i = i + 1;
    }
    return out;
}

def main(): Int {
    // Diffie-Hellman in the multiplicative group of GF(p).
    val F = primeField(2147483647);           // the Mersenne prime 2^31 - 1
    val g = F.generator();
    val alice = g ** 123456789;
    val bob = g ** 987654321;
    val sharedA = bob ** 123456789;
    val sharedB = alice ** 987654321;
    println("shared secret " + sharedA.toString() + ", agree: " + (sharedA == sharedB));

    // Solve x^2 = 10 (mod 13) with a square root in GF(13).
    val G = primeField(13);
    val root = G.of(10).sqrt();
    println("sqrt(10) in GF(13) = " + root.toString() + ", check: " + (root * root).toString());

    // Z/15Z is a ring with zero divisors.
    val R = integersMod(15);
    println("3 * 5 = " + (R.of(3) * R.of(5)).toString() + "; units: " + R.unitCount());

    // Polynomials over GF(5): x^4 - 1 splits into linear factors.
    val x = primeField(5).x();
    val f = x ** 4 - 1;
    println(f.toString() + " = (" + (f / (x - 1)).toString() + ")(x - 1), irreducible: " + f.isIrreducible());

    // GF(2^8), the field of AES.
    val K = galoisField(2, 8);
    println("GF(256) = GF(2)[x]/(" + K.modulus().toString() + ")");
    val s = aesSbox(K, 83);                   // S(0x53) = 0xED = 237
    println("AES S-box(0x53) = " + s);
    if (s != 237 or !(sharedA == sharedB)) { return 1; }
    return 0;
}
